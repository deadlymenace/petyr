# LLM API Keys
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MOONSHOT_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Stock Market API Key
FINANCIAL_DATASETS_API_KEY=your-api-key

# Macro Data (FRED) — macro_search tool is only enabled when set
FRED_API_KEY=your-api-key

# Web Search API Keys (Exa → Perplexity → Tavily)
EXASEARCH_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# LangSmith
LANGSMITH_API_KEY=your-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=petyr
LANGSMITH_TRACING=true

# Web server (bun run web)
# PETYR_WEB_PORT=3000
# Comma-separated invite codes gating the research preview at /app (unset = open)
# PETYR_INVITE_CODES=code1,code2
# Comma-separated hostnames allowed for CORS
# PETYR_ALLOWED_HOSTS=localhost,127.0.0.1

# Waitlist
# Persistent data dir — REQUIRED in production (e.g. a Railway volume mounted at /data),
# otherwise signups are lost on redeploy. Falls back to ./.petyr locally.
# PETYR_DATA_DIR=/data
# Bearer token for GET /api/waitlist/export (unset = export disabled)
# PETYR_ADMIN_TOKEN=generate-a-long-random-string
